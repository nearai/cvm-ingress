# Deny-by-default catch-all (nearai/infra#195): any request whose Host header
# does not match ${DOMAIN} (arbitrary domains, localhost, IP literals) is
# routed here by nginx's virtual-server selection and the connection is closed
# (444) before any proxying. Malformed Host values are rejected by nginx
# itself with a generic 400 before server selection.
#
# /nginx-health stays reachable on this catch-all so loopback/in-container
# probes that address the listener by IP keep working in non-TLS mode.
server {
    listen 8443 default_server;
    server_name _;

    location = /nginx-health {
        return 200 "ok";
    }

    location / {
        return 444;
    }
}

server {
    listen 8443;
    server_name ${DOMAIN};

    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_connect_timeout 5s;
    client_max_body_size 100m;

    resolver 127.0.0.11 valid=5s;
    set ${DOLLAR}backend "http://${BACKEND_HOST}:${BACKEND_PORT}";

    # When nginx itself cannot reach the backend (connection refused, timeout),
    # close the TCP connection instead of returning an HTTP error. This makes
    # the failure visible as a TCP RST to upstream L4 proxies, allowing them
    # to mark this backend as unavailable and route to healthy instances.
    # Note: proxy_intercept_errors is intentionally OFF (default) so that
    # HTTP errors returned BY the backend (e.g. cloud-api returning 502
    # because an inference provider failed) pass through to the client normally.
    error_page 502 503 504 = @backend_down;

    location @backend_down {
        return 444;
    }

    # Errors generated by nginx ITSELF (malformed requests, oversized
    # bodies/headers, client timeouts) return a minimal generic JSON envelope
    # instead of nginx's default error page, which embeds the server version
    # banner (nearai/infra#192). Backend-generated errors are unaffected:
    # proxy_intercept_errors stays off, so documented API error envelopes
    # pass through untouched, and 502/503/504 keep the @backend_down path.
    error_page 400 401 403 404 405 408 413 414 421 431 494 /__cvm_ingress_4xx;
    error_page 500 501 505 /__cvm_ingress_5xx;

    location = /__cvm_ingress_4xx {
        internal;
        default_type application/json;
        return 200 '{"error":{"message":"The request could not be processed.","type":"invalid_request_error","param":null,"code":null}}';
    }

    location = /__cvm_ingress_5xx {
        internal;
        default_type application/json;
        return 200 '{"error":{"message":"An internal error occurred.","type":"api_error","param":null,"code":null}}';
    }

    location / {
        proxy_pass ${DOLLAR}backend;
        # Pin the upstream Host header to the configured domain instead of
        # forwarding the client-supplied value (nearai/infra#195).
        proxy_set_header Host ${DOMAIN};
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /nginx-health {
        return 200 "ok";
    }
}
