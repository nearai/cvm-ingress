server {
    # HTTP/1.1 + HTTP/2 over TCP.
    listen 8443 ssl;
    listen [::]:8443 ssl;
    # HTTP/3 over QUIC (UDP). `reuseport` enables per-worker socket sharding;
    # safe here because cvm-ingress renders exactly one server block.
    listen 8443 quic reuseport;
    listen [::]:8443 quic reuseport;

    http2 on;
    http3 on;

    server_name ${DOMAIN};

    ssl_certificate /certs/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /certs/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;
    ssl_early_data on;

    # Advertise HTTP/3 to compliant clients. Browsers will only upgrade if the
    # UDP path actually works; otherwise they fall back to HTTP/2 silently.
    # ma=86400 = cache the advertisement for 24h once verified.
    add_header Alt-Svc 'h3=":8443"; ma=86400' always;

    # Security headers (nearai/infra#196). `always` attaches them to every
    # response status, including proxied 4xx/5xx and locally generated errors.
    #
    # add_header inheritance trap: server-level add_header directives reach a
    # location only if that location declares NO add_header of its own. Keep
    # location blocks in this file free of add_header (or re-declare the full
    # set there) — tests/test-headers.sh enforces this invariant.
    add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;
    add_header X-Content-Type-Options 'nosniff' always;

    # The backend does not set these headers itself (audited 2026-07-22), but
    # hide any upstream copy so the add_header values above stay the single
    # source of truth if a backend ever starts emitting them.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;

    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_connect_timeout 5s;
    client_max_body_size 100m;

    resolver 127.0.0.11 valid=5s;
    set ${DOLLAR}backend "http://${BACKEND_HOST}:${BACKEND_PORT}";

    # When nginx itself cannot reach the backend (connection refused, timeout),
    # close the TCP connection instead of returning an HTTP error. This makes
    # the failure visible as a TCP RST to upstream L4 proxies, allowing them
    # to mark this backend as unavailable and route to healthy instances.
    # Note: proxy_intercept_errors is intentionally OFF (default) so that
    # HTTP errors returned BY the backend (e.g. cloud-api returning 502
    # because an inference provider failed) pass through to the client normally.
    error_page 502 503 504 = @backend_down;

    location @backend_down {
        return 444;
    }

    location / {
        proxy_pass ${DOLLAR}backend;
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Early-Data ${DOLLAR}ssl_early_data;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /nginx-health {
        return 200 "ok";
    }
}
