# Deny-by-default catch-all (nearai/infra#195).
#
# TLS layer: any client whose SNI is not exactly ${DOMAIN} lands on this
# default_server and the handshake itself is rejected (unrecognized_name
# alert) — this covers arbitrary SNI, empty SNI, and IP-literal connections.
#
# HTTP layer: a request that completed the handshake with the correct SNI but
# carries a Host / :authority header that does not match ${DOMAIN} (arbitrary
# domains, localhost, IP literals, SNI/Host mismatches) is routed here by
# nginx's virtual-server selection and the connection is closed (444) before
# any proxying. Malformed Host values are rejected by nginx itself with a
# generic 400 before server selection.
#
# Loopback/deploy health checks must therefore send the real domain as both
# SNI and Host, e.g.:
#   curl -sk --connect-to ${DOMAIN}:443:127.0.0.1:<port> https://${DOMAIN}/nginx-health
server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    listen 8443 quic default_server;
    listen [::]:8443 quic default_server;

    server_name _;
    ssl_reject_handshake on;

    return 444;
}

server {
    # HTTP/1.1 + HTTP/2 over TCP.
    listen 8443 ssl;
    listen [::]:8443 ssl;
    # HTTP/3 over QUIC (UDP). `reuseport` enables per-worker socket sharding;
    # it is a socket-level option and may only appear on one listen directive
    # per address:port, so the catch-all above does not repeat it.
    listen 8443 quic reuseport;
    listen [::]:8443 quic reuseport;

    http2 on;
    http3 on;

    server_name ${DOMAIN};

    ssl_certificate /certs/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /certs/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;
    ssl_early_data on;

    # Advertise HTTP/3 to compliant clients. Browsers will only upgrade if the
    # UDP path actually works; otherwise they fall back to HTTP/2 silently.
    # ma=86400 = cache the advertisement for 24h once verified.
    add_header Alt-Svc 'h3=":8443"; ma=86400' always;

    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_connect_timeout 5s;
    client_max_body_size 100m;

    resolver 127.0.0.11 valid=5s;
    set ${DOLLAR}backend "http://${BACKEND_HOST}:${BACKEND_PORT}";

    # When nginx itself cannot reach the backend (connection refused, timeout),
    # close the TCP connection instead of returning an HTTP error. This makes
    # the failure visible as a TCP RST to upstream L4 proxies, allowing them
    # to mark this backend as unavailable and route to healthy instances.
    # Note: proxy_intercept_errors is intentionally OFF (default) so that
    # HTTP errors returned BY the backend (e.g. cloud-api returning 502
    # because an inference provider failed) pass through to the client normally.
    error_page 502 503 504 = @backend_down;

    location @backend_down {
        return 444;
    }

    location / {
        proxy_pass ${DOLLAR}backend;
        # Pin the upstream Host header to the configured domain instead of
        # forwarding the client-supplied value, so the backend can never see
        # (or act on) an attacker-controlled Host (nearai/infra#195). Requests
        # only reach this server when the Host already matches ${DOMAIN}; the
        # pin makes the value deterministic (no port suffix, no case variants).
        proxy_set_header Host ${DOMAIN};
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Early-Data ${DOLLAR}ssl_early_data;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /nginx-health {
        return 200 "ok";
    }
}
